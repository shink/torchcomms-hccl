include CMakeLists.txt
include LICENSE
include README.md
include README_zh.md
include requirements.txt
include requirements_dev.txt
include build.sh
include setup.py
include pyproject.toml
include .clang-format

# Git submodule 配置(供从 git 检出构建时初始化 submodule 使用)
include .gitmodules

# C++ 源码
recursive-include src *.hpp *.cpp *.h

# CANN Stub 源码
recursive-include third_party/stubs *.c

recursive-include third_party/hccl/include *.h *.hpp
recursive-include third_party/hcomm/include *.h *.hpp
recursive-include third_party/hcomm/test/stub/depends/include *.h *.hpp
recursive-include third_party/runtime/include/external *.h *.hpp
recursive-include third_party/torchcomms/comms/torchcomms *.hpp

# 排除杂项
global-exclude *.pyc *.pyo
prune .github
